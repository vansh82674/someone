datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  LISTENER
}

model User {
    id            Int          @id @default(autoincrement())
    email         String       @unique
    password      String
    name          String
    anonId        String       @unique
    role          Role         @default(USER)
    isAdmin       Boolean      @default(false)
    
    // Listener specific fields
    isVerified    Boolean      @default(false)
    tagline       String?
    rating        Float        @default(0)
    reviewsCount  Int          @default(0)
    quote         String?
    topics        String[]     @default([])
    hourlyRate    Int          @default(199)
    bgColor       String?
    walletBalance Int          @default(0)

    sessionLogs   SessionLog[]
    transactions  Transaction[]
}

model SessionLog {
    id              String    @id @default(uuid())
    userId          Int
    user            User      @relation(fields: [userId], references: [id])
    partnerAnonId   String?
    durationSeconds Int       @default(0)
    topic           String?
    endedBy         String    // 'USER', 'PARTNER', 'SYSTEM'
    createdAt       DateTime  @default(now())
}

model ModerationEvent {
    id          String   @id @default(uuid())
    sessionId   String
    reporterId  Int
    reason      String
    timestamp   DateTime @default(now())
}

model Transaction {
    id          String   @id @default(uuid())
    userId      Int
    user        User     @relation(fields: [userId], references: [id])
    amount      Int
    type        String   // 'CREDIT_ADD', 'CHAT_DEDUCTION', 'CHAT_EARNING', 'PAYOUT'
    status      String   @default("PENDING") // 'PENDING', 'SUCCESS', 'FAILED'
    referenceId String?  // Razorpay payment ID or Session ID
    createdAt   DateTime @default(now())
}